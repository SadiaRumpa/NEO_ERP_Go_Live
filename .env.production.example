# ==============================================================================
# NeoERP - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env on your production or staging server:
#   cp .env.production.example .env
# Then generate your application key:
#   php artisan key:generate
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME="NeoERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.yourcompany.com

# ------------------------------------------------------------------------------
# 2. LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Choose your production database driver: mysql or pgsql

# --- OPTION A: MySQL 8.0+ / MariaDB 10.5+ / AWS RDS / DigitalOcean Managed ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neoerp_production
DB_USERNAME=neoerp_user
DB_PASSWORD=YourStrongDatabasePasswordHere

# If using AWS RDS, DigitalOcean, or Azure MySQL with SSL Enforcement:
# DB_SSL_CA=/path/to/rds-combined-ca-bundle.pem
# MYSQL_ATTR_SSL_CA=/path/to/ca-certificate.crt

# --- OPTION B: PostgreSQL 14+ / Supabase / Neon / AWS RDS Postgres ---
# DB_CONNECTION=pgsql
# DB_HOST=your-postgres-host.com
# DB_PORT=5432
# DB_DATABASE=neoerp_production
# DB_USERNAME=neoerp_user
# DB_PASSWORD=YourStrongDatabasePasswordHere
# DB_SCHEMA=public
# DB_SSLMODE=require

# ------------------------------------------------------------------------------
# 4. SESSIONS, CACHE & ASYNC QUEUES
# ------------------------------------------------------------------------------
# For high-traffic production, Redis is recommended.
# Fallback: 'database' (supported out of the box with existing migrations).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=neoerp_cache_

QUEUE_CONNECTION=database

# --- Redis Configuration (If using Redis for Session/Cache/Queue) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (AWS S3 / Cloudflare R2 / DigitalOcean Spaces)
# ------------------------------------------------------------------------------
# Essential in cloud/containerized environments so job attachments, drawings,
# and delivery notes persist across server restarts and deployments.
FILESYSTEM_DISK=local
# For S3 / R2 / Spaces:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your-s3-access-key
# AWS_SECRET_ACCESS_KEY=your-s3-secret-key
# AWS_DEFAULT_REGION=eu-west-2
# AWS_BUCKET=your-production-bucket-name
# AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_URL=https://your-production-bucket.s3.eu-west-2.amazonaws.com

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (SMTP / SES / SendGrid / Postmark / Mailgun)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourcompany.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 7. BROADCASTING & REAL-TIME WEBSOCKETS
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=log

# ------------------------------------------------------------------------------
# 8. THIRD-PARTY APIS & VERIFICATION SERVICES
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
POSTCODE_API_KEY=
NEW_POSTCODE_API_KEY=

NOCAPTCHA_SECRET=
NOCAPTCHA_SITEKEY=

# ------------------------------------------------------------------------------
# 9. INITIAL SUPER ADMIN SEED CREDENTIALS
# ------------------------------------------------------------------------------
# Used only when running 'php artisan db:seed --class=CreateAdminUserSeeder'
INITIAL_ADMIN_NAME="Super Administrator"
INITIAL_ADMIN_EMAIL=admin@yourcompany.com
INITIAL_ADMIN_PASSWORD=ChangeThisPasswordBeforeDeploying2026!
