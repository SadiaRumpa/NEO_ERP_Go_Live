APP_NAME=NeoERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration:
# Default for zero-setup local testing: sqlite
DB_CONNECTION=sqlite

# For MySQL / MariaDB (Local or Cloud RDS/DigitalOcean):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=neoerp
# DB_USERNAME=root
# DB_PASSWORD=
# DB_SSL_CA=

# For PostgreSQL (Cloud Supabase/Neon/AWS):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=neoerp
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@neoerp.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Third-party integrations
GOOGLE_MAPS_API_KEY=
POSTCODE_API_KEY=
NEW_POSTCODE_API_KEY=

NOCAPTCHA_SECRET=
NOCAPTCHA_SITEKEY=

# Initial Super Admin credentials for database seeder
INITIAL_ADMIN_EMAIL=admin@neoerp.local
INITIAL_ADMIN_PASSWORD="NeoErp!Admin2026#Secure"
